{
  "name": "arpan-pramanik",
  "version": "2.0.1",
  "description": "Interactive CLI Portfolio of Arpan Pramanik",
  "main": "dist/index.js",
  "bin": {
    "arpan-pramanik": "./dist/index.js"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "index.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node18 --minify --outfile=dist/index.js",
    "check:size": "node scripts/check-size.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && npm run check:size && node --test tests/*.test.js"
  },
  "keywords": [
    "portfolio",
    "cli",
    "ai",
    "machine-learning",
    "developer",
    "research",
    "terminal-portfolio",
    "arpan-pramanik"
  ],
  "author": "Arpan Pramanik <pramanikarpan089@gmail.com>",
  "license": "MIT",
  "homepage": "https://arpanpramanik.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpanpramanik2003/npx-arpan-pramanik.git"
  },
  "bugs": {
    "url": "https://github.com/arpanpramanik2003/npx-arpan-pramanik/issues"
  },
  "type": "commonjs",
  "dependencies": {},
  "devDependencies": {
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "esbuild": "^0.28.2",
    "figlet": "^1.8.2",
    "gradient-string": "^2.0.2",
    "open": "^8.4.2"
  }
}
